{
  "name": "@webuildforgood/skill-system-invariant-engine",
  "version": "2.0.0",
  "description": "Pre-commit and CI gate that enforces the rules a repository writes in invariants.json: forbidden text with automatic fixes, file-size limits, and Prettier.",
  "main": "bin/invariant-check.mjs",
  "bin": {
    "wb4g-invariants": "bin/invariant-check.mjs"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node bin/invariant-check.mjs",
    "fix": "node bin/invariant-check.mjs --fix"
  },
  "keywords": [
    "invariants",
    "pre-commit",
    "commit-msg",
    "linter",
    "ai-agents",
    "prettier"
  ],
  "author": "We Build for Good",
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "invariants.json",
    "examples"
  ],
  "engines": {
    "node": ">=18"
  }
}
